# Copy this file to .env and fill in real values.
# Never commit .env (it is git-ignored).

# Port the API listens on (default: 5000)
PORT=5000

# MongoDB connection string (MongoDB Atlas or local)
DB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Frontend origin allowed by CORS (default: http://localhost:3000)
CLIENT_URL=http://localhost:3000
# BetterAuth URL (must match the Next.js auth baseURL)
BETTER_AUTH_URL=http://localhost:3000
# Stripe Test Mode
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
